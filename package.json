{
  "name": "focuslist",
  "version": "2.0.0",
  "description": "Modern daily task and priority engine engineered for laser focus, seamless prioritization, and high productivity. Built for the FrontendArena Hackathon.",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "npx serve .",
    "dev": "npx serve .",
    "test": "node tests/run-tests.js",
    "test:watch": "node tests/run-tests.js --watch",
    "lint": "npx eslint app.js",
    "format": "npx prettier --check \"**/*.{html,css,js,json,md}\"",
    "format:fix": "npx prettier --write \"**/*.{html,css,js,json,md}\"",
    "preview": "npx serve ."
  },
  "keywords": [
    "todo",
    "task-manager",
    "productivity",
    "priority-engine",
    "vanilla-javascript",
    "frontend",
    "pwa",
    "hackathon",
    "frontend-arena",
    "offline-first"
  ],
  "author": "Priyanshi Srivastava <senorita130227@gmail.com> (https://github.com/priyanshi02-lyt)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/priyanshi02-lyt/FocusList.git"
  },
  "bugs": {
    "url": "https://github.com/priyanshi02-lyt/FocusList/issues"
  },
  "homepage": "https://focuslist-bay.vercel.app",
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.2.5",
    "serve": "^14.2.1"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
